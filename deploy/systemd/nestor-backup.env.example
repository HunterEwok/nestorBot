# Copy to /etc/nestor-backup/backup.env (root:nestor-backup, 0640). No password here: the password of the
# database role nestor_backup is in /etc/nestor-backup/pgpass (nestor-backup.service sets PGPASSFILE).
# After `python -m nestor.bootstrap harden --ssl` says "ssl": true, change sslmode=prefer to sslmode=require.
BACKUP_DATABASE_URL=postgresql://nestor_backup@192.168.0.1:5432/nestor?sslmode=prefer&connect_timeout=10&keepalives=1&keepalives_idle=30&keepalives_interval=10&keepalives_count=3&tcp_user_timeout=60000
TIMEZONE=Europe/Moscow
# The scheduled slot, local time: the same as the first OnCalendar of nestor-backup.timer.
BACKUP_AT=04:30

# Optional, shown with their defaults.
# The directory of pg_dump and pg_restore; empty: the newest /usr/lib/postgresql/*/bin.
# BACKUP_PG_BINDIR=
# gzip:6 where pg_dump has no zstd.
# BACKUP_COMPRESS=zstd:3
# Free space the card needs before a dump, on top of twice the size of the last one.
# BACKUP_MIN_FREE_MB=1024
# Per attempt.
# BACKUP_TIMEOUT_MIN=10
# BACKUP_ATTEMPTS=6
# Between attempts.
# BACKUP_RETRY_MIN=5
