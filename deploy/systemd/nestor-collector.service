[Unit]
Description=nestor collector: archives allowed Telegram groups to PostgreSQL
# PostgreSQL runs on another machine; if it is unreachable at boot, migrate fails
# and systemd keeps restarting until it is back (no start limit below).
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=nestor
Group=nestor
WorkingDirectory=/opt/nestor
EnvironmentFile=/opt/nestor/.env
ExecStartPre=/opt/nestor/.venv/bin/python -m nestor.migrate
ExecStart=/opt/nestor/.venv/bin/python -m nestor.collector
Restart=always
RestartSec=10
# Logs go to journald (JSON, no message text); retention: deploy/journald/nestor.conf.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=300M

[Install]
WantedBy=multi-user.target
