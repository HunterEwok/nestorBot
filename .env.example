# Copy to .env (on the Pi: chmod 600). Values below match docker-compose.yml for local development.

# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC...
# Comma-separated group ids the bot may read (FR-7). Supergroups look like -100...
ALLOWED_CHAT_IDS=-1001234567890
LOG_LEVEL=INFO

# Collector connection (role nestor, owner of the schema)
DATABASE_URL=postgresql://nestor:nestor@localhost:5432/nestor

# Only for python -m nestor.bootstrap (superuser, one-time setup)
PG_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
COLLECTOR_PASSWORD=nestor
READER_PASSWORD=reader

# Only for pytest: superuser of a THROWAWAY cluster (db-test in docker-compose.yml)
NESTOR_TEST_PG_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/postgres

# Only for history import on your laptop (python -m nestor.importer), never on the Pi.
# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Stage 3: answering through Hermes (profile `group`). Leave HERMES_URL empty to only archive.
HERMES_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Profile `web` (internet search, no archive). Leave empty: questions that need the internet are refused.
HERMES_WEB_URL=
HERMES_WEB_API_KEY=
# Profile `smart` (internet only, a bigger model) for songs and the wisdom of the day. Empty: `web` is used.
HERMES_SMART_URL=
HERMES_SMART_API_KEY=
# Songs per day, all groups together (they go to the bigger model).
MUSIC_DAILY_LIMIT=10
# Groups that get the wisdom of the day by default; a group admin can switch it with /wisdom.
WISDOM_CHAT_IDS=
# Local times (TIMEZONE) of the wisdom of the day and of the morning digest (/digest, off by default).
WISDOM_TIME=21:00
DIGEST_TIME=09:00
# Reminders, daily posts and the daily token limit use this time zone.
TIMEZONE=Europe/Tallinn
BOT_KEYWORDS=нестор,бот
RATE_LIMIT_PER_USER=5
RATE_LIMIT_WINDOW_MIN=10
# All chats together per day (Europe/Tallinn). Tune to the monthly budget after a week of bot_requests data.
DAILY_TOKEN_LIMIT=250000
