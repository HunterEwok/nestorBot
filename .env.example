# Copy to .env and chmod 600.
BOT_TOKEN=123456:ABC...
# Collector role (owner of the schema). Unix socket, no TCP needed on the Pi.
DATABASE_URL=postgresql://nestor:CHANGE_ME@localhost/nestor
# Comma-separated group ids the bot may read (FR-7). Supergroups look like -100...
ALLOWED_CHAT_IDS=-1001234567890
LOG_LEVEL=INFO
