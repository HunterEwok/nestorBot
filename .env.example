# Copy to .env (on the Pi: chmod 600). Values below match docker-compose.yml for local development.

# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC...
# Comma-separated group ids the bot may read (FR-7). Supergroups look like -100...
ALLOWED_CHAT_IDS=-1001234567890
# Comma-separated Telegram user ids that may use the admin commands in every allowed group without being
# its admin (the owner). Empty: only the group's own admins.
OWNER_IDS=
LOG_LEVEL=INFO

# Collector connection (role nestor, owner of the schema)
DATABASE_URL=postgresql://nestor:nestor@localhost:5432/nestor

# Only for python -m nestor.bootstrap (superuser, one-time setup)
PG_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
COLLECTOR_PASSWORD=nestor
READER_PASSWORD=reader
# The role of the nightly pg_dump (nestor_backup, read-only). Empty: bootstrap does not touch it; set, it creates
# the role too, and `python -m nestor.bootstrap backup` does only that, on the server of PG_ADMIN_URL (for the
# router both are typed in, see README «Резервные копии»). The same password goes into the Pi's
# /etc/nestor-backup/pgpass. A long random one: openssl rand -hex 32
BACKUP_PASSWORD=

# Only for pytest: superuser of a THROWAWAY cluster (db-test in docker-compose.yml)
NESTOR_TEST_PG_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/postgres

# Only for history import on your laptop (python -m nestor.importer), never on the Pi.
# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# The bot's id, the number before the colon in its token: its own messages are not imported.
# The token itself is not needed on the laptop.
BOT_ID=

# Stage 3: answering through Hermes (profile `group`). Leave HERMES_URL empty to only archive.
HERMES_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Profile `web` (internet search, no archive). Leave empty: questions that need the internet are refused.
HERMES_WEB_URL=
HERMES_WEB_API_KEY=
# Profile `smart` (internet only, a bigger model) for songs and the wisdom of the day. Empty: `web` is used.
HERMES_SMART_URL=
HERMES_SMART_API_KEY=
# Profile `deep` (the archive tools, a bigger model) for «оцени тезисы», «кто прав» and «нестор, подумай». Empty: `group`.
HERMES_DEEP_URL=
HERMES_DEEP_API_KEY=
# Profile `news` (no tools, a cheap model) sorts the news digest's items. Empty: `web`.
HERMES_NEWS_URL=
HERMES_NEWS_API_KEY=
# Optional: move tasks between profiles, e.g. theses:group,music:web,news:web (see nestor/bot/routing.py).
MODEL_ROUTES=
# Songs per day, all groups together (they go to the bigger model).
MUSIC_DAILY_LIMIT=10
# Short name of the player Mini App (deploy/player/README.md): a «▶️ Плеер» button that plays the song's
# video inside Telegram on a computer too. Empty: no button, the preview still plays on phones.
MUSIC_PLAYER_APP=
# Groups that get the wisdom of the day by default; a group admin can switch it with /wisdom.
WISDOM_CHAT_IDS=
# Local times (TIMEZONE) of the wisdom of the day and of the group digest (/digest, off by default).
WISDOM_TIME=21:00
DIGEST_TIME=09:00
# The group digest comes once every this many days (1-90) and retells them; 1: every morning, about yesterday.
# A group admin sets the group's own period with /digest N.
DIGEST_EVERY_DAYS=30
# Groups where the bot puts reactions on emotional messages by default; a group admin can switch it
# with /reactions on|off. The model picks them through the `news` profile, without it only sure rules.
REACTION_CHAT_IDS=
# Addressing in one's own words, switched on per group by an admin with /address on (off by default):
# «слушай, Нестор, а ты как думаешь?», or the person's next message within ADDRESS_WINDOW_MIN minutes (1-60)
# after the bot answered them («а ты уверен?»). A doubtful message and ADDRESS_CONTEXT messages before it
# (0-20) go without names to the `news` profile for a yes or a no; at most ADDRESS_DAILY_CHECKS such checks
# per group per day (0-2000), until DAILY_TOKEN_LIMIT is spent but for 3000 tokens a check, kept for the answer
# to its yes (reactions and remarks stop at half of it).
# Without the `news` profile doubtful messages stay unanswered.
ADDRESS_WINDOW_MIN=5
ADDRESS_CONTEXT=4
ADDRESS_DAILY_CHECKS=150
# The bot's own remarks, switched on per group by an admin with /chime on (off by default): once an hour within
# CHIME_HOURS (local time), when people wrote at least CHIME_MIN_MESSAGES messages in the last hour (1-500), the
# last CHIME_WINDOW of them (1-100) go without names to the `news` profile, which mostly stays silent and now and
# then answers one message. At most CHIME_DAILY remarks per group per day (0-24); without the `news` profile, none.
CHIME_HOURS=10:00-23:00
CHIME_MIN_MESSAGES=10
CHIME_WINDOW=40
CHIME_DAILY=3
# Evening news digest (nestor/news): groups that get it by default (a group admin can switch it with
# /news on|off), local time, topics per digest. Nothing is fetched while no group has it on.
NEWS_CHAT_IDS=
NEWS_TIME=20:00
NEWS_MAX_TOPICS=2
# Significance 1-10 the digest model must give a story for it to go out; none that high: no digest that day.
NEWS_MIN_SCORE=7
# Your e-mail for the User-Agent and NCBI's email= parameter (they ask for a contact). Only here, nowhere else.
NEWS_CONTACT_EMAIL=
# Public Telegram channels read through t.me/s/<name>, comma-separated.
NEWS_TELEGRAM_CHANNELS=psychedelicsocietyvienna
# The viral song of the day (nestor/trends): groups that get it by default (a group admin can switch it with
# /music on|off; /music now looks right away, up to ten times an hour) and its local time, every day.
# The charts of Yandex Music, Apple Music and Shazam (Russia and Moscow) are read once a day while a group has it
# on; on the first start half a year of their history is copied from the Wayback Machine.
MUSIC_CHAT_IDS=
MUSIC_TIME=19:00
# Optional: a Last.fm API key (https://www.last.fm/api/account/create) adds its chart of Russia.
LASTFM_API_KEY=
# Optional: Yandex Music gives its chart only to Russian addresses (HTTP 451 elsewhere). An http(s) proxy in
# Russia, used for that one request only, like http://user:password@host:port. Not a VPN for the whole Pi:
# Anthropic does not serve Russia, so the models would stop answering.
MUSIC_YANDEX_PROXY=
# Reminders, daily posts and the daily token limit use this time zone.
TIMEZONE=Europe/Moscow
# Local time (TIMEZONE) of the nightly purge of what entered the archive more than 12 months ago.
RETENTION_TIME=03:30
BOT_KEYWORDS=нестор,бот
RATE_LIMIT_PER_USER=5
RATE_LIMIT_WINDOW_MIN=10
# All chats together per day (a day in TIMEZONE). Tune to the monthly budget after a week of bot_requests data.
DAILY_TOKEN_LIMIT=250000

# Stage 4: alerts of nestor.watchdog (deploy/systemd/nestor-watchdog.timer, every 5 minutes) go to this group.
# It must be one of ALLOWED_CHAT_IDS (the bot leaves every other group); its admins get /status there.
# Empty: no alerts, no /status.
ALERT_CHAT_ID=
# Local time (TIMEZONE) of the silent daily summary of yesterday; off: none.
ALERT_DAILY_AT=09:30
# Quiet hours, local time: alerts arrive without sound (a crit open for over an hour, or still open when they
# end, rings once); off: never.
ALERT_QUIET=23:00-08:00
# Free space on the Pi's card below this many GB is a warning (below 1 GB critical).
ALERT_DISK_MIN_GB=5
# The daily summary goes only to a group with at most this many members, the bot included.
ALERT_MAX_MEMBERS=2
# nestor.backup's status file, read by the watchdog (nestor-backup.service keeps it there on the Pi).
# Emptying it turns the watching of the backups off.
BACKUP_STATUS_FILE=/var/lib/nestor-backup/status.json
